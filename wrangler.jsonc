{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cpcredit",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // Interfața: fișierele generate de `npm run build` în ./public
  "build": { "command": "node scripts/build.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Baza de date D1. După `npx wrangler d1 create cpcredit`, pune aici database_id primit.
  "d1_databases": [
    { "binding": "DB", "database_name": "cpcredit", "database_id": "a28a0c3a-d76a-4e2d-9cff-407858f72084", "migrations_dir": "migrations" }
  ],

  // Bucketul R2 separat pentru fișierele încărcate pe dosare.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "cpcredit-files" }
  ],

  // Autentificarea folosește două secrete, care nu stau în repo:
  //   npx wrangler secret put LOGIN_PASSWORD   - parola de intrare (temporară, până la cod pe email)
  //   npx wrangler secret put ADMIN_EMAILS     - primii administratori, separați prin virgulă
  // Fără LOGIN_PASSWORD nu poate intra nimeni. Restul utilizatorilor se adaugă din ecranul Utilizatori.

  "observability": { "enabled": true }
}
